#!/bin/sh

#
# usage: set-wallpaper

set -u

IMG="$1" BG="$2" 
[ -f "$IMG" ] || { echo "no such wallpaper: $IMG" >&2; exit 1; }

# Serialize concurrent runs — the last pick wins whole. Spawned daemons
# must not inherit fd 9 (the 9>&- below) or the lock outlives the script;
# the bounded wait turns a leaked lock into a delay, not a deadlock.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/set-wallpaper.lock"
flock -w 60 9 || echo "set-wallpaper: lock timeout, proceeding unlocked" >&2

# 6. Wallpaper now + persist the choice outside the tracked config so
#    switching wallpapers doesn't dirty autostart in git. autostart reads
#    wallpaper/current on the next login.
feh --bg-fill "$IMG"
mkdir -p "$XDG_CONFIG_HOME/wallpaper"
printf '%s\n' "$(basename "$IMG")" > "$XDG_CONFIG_HOME/wallpaper/current"

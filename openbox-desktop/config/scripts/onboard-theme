#!/usr/bin/env python3
"""Render Onboard's aa-linux color scheme from theme/colors.ini.

Onboard does not expose a reload method, but it watches the
`org.onboard.theme-settings color-scheme` GSetting and rebuilds the layout
when that value changes. To apply rewritten colors without restarting:

  1. render the template to aa-linux.colors
  2. point the GSetting at a temporary copy of the same scheme
  3. point it back at aa-linux.colors

Both writes are real value changes, so dconf emits the change signals and
Onboard repaints with the new palette. Exits quietly when Onboard is not
installed or its schema is unavailable.
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

CONFIG_DIR = Path(__file__).resolve().parent.parent
PALETTE = CONFIG_DIR / "theme" / "colors.ini"
TEMPLATE = CONFIG_DIR / "onboard" / "themes" / "aa-linux.colors.template"
OUTPUT = CONFIG_DIR / "onboard" / "themes" / "aa-linux.colors"

SCHEMA = "org.onboard.theme-settings"
KEY = "color-scheme"
REQUIRED = (
    "background", "background-alt", "foreground", "border",
    "primary", "secondary", "alert", "disabled",
)
TOKEN_RE = re.compile(r"\{\{([A-Z_]+)\}\}")


def read_palette(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.split(";", 1)[0].strip()
        if not line or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key, value = key.strip(), value.strip()
        if key and value:
            values[key] = value

    missing = [key for key in REQUIRED if key not in values]
    if missing:
        raise SystemExit(f"onboard-theme: missing palette keys: {', '.join(missing)}")

    for key in REQUIRED:
        if not re.fullmatch(r"#[0-9a-fA-F]{6}", values[key]):
            raise SystemExit(f"onboard-theme: invalid color for {key}: {values[key]}")

    return values


def rgb(value: str) -> tuple[int, int, int]:
    value = value.lstrip("#")
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))


def hex_color(channels: tuple[float, float, float]) -> str:
    return "#" + "".join(
        f"{max(0, min(255, round(channel))):02x}" for channel in channels
    )


def mix(a: str, b: str, amount: float) -> str:
    return hex_color(tuple(
        x + (y - x) * amount for x, y in zip(rgb(a), rgb(b))
    ))


def luminance(value: str) -> float:
    def linear(channel: int) -> float:
        channel /= 255
        if channel <= 0.04045:
            return channel / 12.92
        return ((channel + 0.055) / 1.055) ** 2.4

    r, g, b = rgb(value)
    return 0.2126 * linear(r) + 0.7152 * linear(g) + 0.0722 * linear(b)


def render(palette: dict[str, str]) -> str:
    palette = dict(palette)
    palette["hover"] = mix(palette["background-alt"], palette["foreground"], 0.04)
    palette["sunken"] = mix(palette["background"], "#000000", 0.22)
    palette["on_primary"] = "#111319" if luminance(palette["primary"]) > 0.45 else "#ffffff"

    text = TEMPLATE.read_text(encoding="utf-8")
    tokens = {
        "BG": palette["background"],
        "ALT": palette["background-alt"],
        "FG": palette["foreground"],
        "BORDER": palette["border"],
        "PRIMARY": palette["primary"],
        "SECONDARY": palette["secondary"],
        "ALERT": palette["alert"],
        "DISABLED": palette["disabled"],
        "HOVER": palette["hover"],
        "SUNKEN": palette["sunken"],
        "ON_PRIMARY": palette["on_primary"],
    }
    for token, value in tokens.items():
        text = text.replace("{{" + token + "}}", value)

    unresolved = TOKEN_RE.findall(text)
    if unresolved:
        raise SystemExit(
            "onboard-theme: unresolved template tokens: " + ", ".join(unresolved)
        )
    return text


def write_output(text: str) -> None:
    tmp = OUTPUT.with_name(OUTPUT.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, OUTPUT)


def gsettings(*args: str) -> bool:
    try:
        result = subprocess.run(
            ["gsettings", *args],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
            check=False,
        )
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def reload_onboard(text: str) -> None:
    if not shutil.which("gsettings"):
        return
    # No schema (Onboard not installed) or no session bus: nothing to reload.
    if not gsettings("get", SCHEMA, KEY):
        return

    home = Path(os.environ.get("HOME", "~")).expanduser()
    user_theme = home / ".local" / "share" / "onboard" / "themes" / "aa-linux.colors"
    target = user_theme if user_theme.exists() else OUTPUT

    # Onboard reads the file by path; a same-content temp scheme avoids a
    # visible flash while still producing the two dconf value changes that
    # trigger its reload handler.
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
    reload_file = runtime / "aa-linux-onboard-reload.colors"
    try:
        reload_file.write_text(text, encoding="utf-8")
        if gsettings("set", SCHEMA, KEY, str(reload_file)):
            time.sleep(0.35)
        gsettings("set", SCHEMA, KEY, str(target))
    except OSError as exc:
        print(f"onboard-theme: reload skipped: {exc}", file=sys.stderr)


def main() -> int:
    palette = read_palette(PALETTE)
    rendered = render(palette)
    write_output(rendered)
    reload_onboard(rendered)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
